# Future Self — environment configuration
# Copy to .env and fill in what you have. Everything is optional at
# runtime: missing services degrade gracefully (see src/lib/config.ts),
# but Supabase is required for real accounts/content/notifications and
# RevenueCat for real purchases.

# --- Supabase (project: claudefutureself) ---
EXPO_PUBLIC_SUPABASE_URL=https://ykgswczatkspryetstor.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- RevenueCat (public SDK keys, per platform) ---
# Test Store keys (test_...) work for development only — they have no
# billing power and initPurchases() refuses to configure with one in a
# release build. Replace with the real per-platform public SDK keys
# (appl_... / goog_...) from the RevenueCat dashboard before shipping.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# RevenueCat entitlement identifier (defaults to "premium" if unset).
# Quote the value if it contains spaces, e.g. EXPO_PUBLIC_RC_ENTITLEMENT_ID="My Entitlement".
EXPO_PUBLIC_RC_ENTITLEMENT_ID=
# Opt-in: present RevenueCat's remote Paywall on the standalone hard gate
# (src/app/paywall.tsx) instead of the custom gate paywall. Never affects
# the in-onboarding variant paywalls (TimelinePaywall/NotePaywall). Off
# by default.
EXPO_PUBLIC_USE_RC_PAYWALL_GATE=false

# --- PostHog (project API key; host defaults to EU) ---
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Sentry ---
EXPO_PUBLIC_SENTRY_DSN=
# Source maps are uploaded at build time via sentry.properties /
# SENTRY_AUTH_TOKEN in CI — never via EXPO_PUBLIC_* vars.

# --- Google Sign-In (OAuth client IDs; see docs/SETUP_REQUIRED.md) ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Email sign-in (OTP via Supabase) ---
# Leave false until custom SMTP is configured in Supabase — Supabase's
# default SMTP only reaches team members, so email OTP would silently
# fail for reviewers/users. Set to true only after SMTP works.
EXPO_PUBLIC_EMAIL_AUTH_ENABLED=false

# --- Development helpers (never set in production builds) ---
# Force one onboarding variant for testing:
#   iam-founder | iam-claude | stella-founder | stella-claude
EXPO_PUBLIC_ONBOARDING_VARIANT_OVERRIDE=
# Explicitly enable the dev-only purchases mock (ignored in release):
EXPO_PUBLIC_DEV_MOCK_PURCHASES=false
