{
  "expo": {
    "name": "Future Self",
    "slug": "futureself",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "futureself",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.futureself.mobile",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.futureself.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F3E9DC",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3E9DC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "@sentry/react-native",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 31
          }
        }
      ],
      [
        "@use-voltra/ios-client",
        {
          "groupIdentifier": "group.com.futureself.mobile",
          "enablePushNotifications": false,
          "targetName": "FutureSelfWidgets",
          "widgets": [
            {
              "id": "daily",
              "displayName": "Daily inspiration",
              "description": "Today's quotes and affirmations, rotating through your day.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "initialStatePath": "./widgets/ios/daily-initial.tsx"
            },
            {
              "id": "future_self",
              "displayName": "Future Self",
              "description": "Your life goal or pinned affirmation — until you change it.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular"
              ],
              "initialStatePath": "./widgets/ios/future-self-initial.tsx"
            }
          ]
        }
      ],
      [
        "@use-voltra/android-client",
        {
          "widgets": [
            {
              "id": "daily",
              "displayName": "Daily inspiration",
              "description": "Today's quotes and affirmations.",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "initialStatePath": "./widgets/android/daily-initial.tsx"
            },
            {
              "id": "future_self",
              "displayName": "Future Self",
              "description": "Your life goal or pinned affirmation.",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "initialStatePath": "./widgets/android/future-self-initial.tsx"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "FutureSelfWidgets",
                  "bundleIdentifier": "com.futureself.mobile.FutureSelfWidgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.futureself.mobile"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "42611c58-20f3-49d7-8e4c-a4c32016e8fd"
      }
    },
    "owner": "norjanssen"
  }
}
