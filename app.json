{
  "expo": {
    "name": "Future Self",
    "slug": "futureself",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "futureself",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.futureself.mobile",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.futureself.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F3E9DC",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3E9DC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "@sentry/react-native",
      "@react-native-google-signin/google-signin",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "MinimalSand",
            "ios": {
              "light": "./assets/icons/icon-minimal_sand.png",
              "dark": "./assets/icons/icon-minimal_sand-dark.png",
              "tinted": "./assets/icons/icon-minimal_sand-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-minimal_sand.png",
              "backgroundColor": "#EDE0D6"
            }
          },
          {
            "name": "OceanClarity",
            "ios": {
              "light": "./assets/icons/icon-ocean_clarity.png",
              "dark": "./assets/icons/icon-ocean_clarity-dark.png",
              "tinted": "./assets/icons/icon-ocean_clarity-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-ocean_clarity.png",
              "backgroundColor": "#DFE8EC"
            }
          },
          {
            "name": "Terracotta",
            "ios": {
              "light": "./assets/icons/icon-terracotta.png",
              "dark": "./assets/icons/icon-terracotta-dark.png",
              "tinted": "./assets/icons/icon-terracotta-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-terracotta.png",
              "backgroundColor": "#E8C6B2"
            }
          },
          {
            "name": "MidnightFocus",
            "ios": {
              "light": "./assets/icons/icon-midnight_focus.png",
              "dark": "./assets/icons/icon-midnight_focus-dark.png",
              "tinted": "./assets/icons/icon-midnight_focus-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-midnight_focus.png",
              "backgroundColor": "#12161A"
            }
          },
          {
            "name": "InkWell",
            "ios": {
              "light": "./assets/icons/icon-ink_well.png",
              "dark": "./assets/icons/icon-ink_well-dark.png",
              "tinted": "./assets/icons/icon-ink_well-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-ink_well.png",
              "backgroundColor": "#1C140D"
            }
          },
          {
            "name": "Arctic",
            "ios": {
              "light": "./assets/icons/icon-arctic.png",
              "dark": "./assets/icons/icon-arctic-dark.png",
              "tinted": "./assets/icons/icon-arctic-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-arctic.png",
              "backgroundColor": "#0F1920"
            }
          },
          {
            "name": "Sun",
            "ios": {
              "light": "./assets/icons/icon-sun.png",
              "dark": "./assets/icons/icon-sun-dark.png",
              "tinted": "./assets/icons/icon-sun-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-sun.png",
              "backgroundColor": "#F5C542"
            }
          },
          {
            "name": "SunriseMomentum",
            "ios": {
              "light": "./assets/icons/icon-sunrise_momentum.png",
              "dark": "./assets/icons/icon-sunrise_momentum-dark.png",
              "tinted": "./assets/icons/icon-sunrise_momentum-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-sunrise_momentum.png",
              "backgroundColor": "#F6D9B8"
            }
          },
          {
            "name": "GoldenSuccess",
            "ios": {
              "light": "./assets/icons/icon-golden_success.png",
              "dark": "./assets/icons/icon-golden_success-dark.png",
              "tinted": "./assets/icons/icon-golden_success-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-golden_success.png",
              "backgroundColor": "#F0DFB3"
            }
          },
          {
            "name": "Evergreen",
            "ios": {
              "light": "./assets/icons/icon-evergreen.png",
              "dark": "./assets/icons/icon-evergreen-dark.png",
              "tinted": "./assets/icons/icon-evergreen-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-evergreen.png",
              "backgroundColor": "#D7E3D2"
            }
          }
        ]
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 31
          }
        }
      ],
      [
        "@use-voltra/ios-client",
        {
          "groupIdentifier": "group.com.futureself.mobile",
          "enablePushNotifications": false,
          "targetName": "FutureSelfWidgets",
          "widgets": [
            {
              "id": "daily",
              "displayName": "Daily inspiration",
              "description": "Today's quotes and affirmations, rotating through your day.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "initialStatePath": "./widgets/ios/daily-initial.tsx"
            },
            {
              "id": "future_self",
              "displayName": "Future Self",
              "description": "Your life goal or pinned affirmation — until you change it.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular"
              ],
              "initialStatePath": "./widgets/ios/future-self-initial.tsx"
            }
          ]
        }
      ],
      [
        "@use-voltra/android-client",
        {
          "widgets": [
            {
              "id": "daily",
              "displayName": "Daily inspiration",
              "description": "Today's quotes and affirmations.",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "initialStatePath": "./widgets/android/daily-initial.tsx"
            },
            {
              "id": "future_self",
              "displayName": "Future Self",
              "description": "Your life goal or pinned affirmation.",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "initialStatePath": "./widgets/android/future-self-initial.tsx"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "FutureSelfWidgets",
                  "bundleIdentifier": "com.futureself.mobile.FutureSelfWidgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.futureself.mobile"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "42611c58-20f3-49d7-8e4c-a4c32016e8fd"
      }
    },
    "owner": "norjanssen"
  }
}
